# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file - it should be in .gitignore.
#
# Create React App requires the REACT_APP_ prefix on all env vars
# you want exposed to the browser. Restart `npm start` after editing.

# Backend API base URL.
#   - Local dev: leave empty (the code falls back to http://localhost:5001)
#   - Production: set to your Render server URL
# REACT_APP_API_BASE=https://the-rack-server.onrender.com

# Stripe publishable key (the pk_test_... or pk_live_... one).
# Get this from https://dashboard.stripe.com (it's the public key, safe to expose)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# PORT=3000