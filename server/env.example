# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file - it should be in .gitignore.

# MongoDB - either set the full URI (production) or DB_USER + DB_PASS (legacy).
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/smartShop?retryWrites=true&w=majority

# Or, for backwards compatibility:
# DB_USER=your_atlas_user
# DB_PASS=your_atlas_password

# JWT signing secret - any long random string
JWT_SECRET=replace_with_long_random_string

# Stripe - get from https://dashboard.stripe.com (test mode is fine)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_key_here

# Port - Render sets this automatically; leave unset locally to default to 5001
# PORT=5001
